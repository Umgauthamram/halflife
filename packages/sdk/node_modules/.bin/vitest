#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/g/projects/halflife/node_modules/.pnpm/vitest@3.2.7_@types+node@22_b5ab45c71b704ef033f8ad34dd490772/node_modules/vitest/node_modules:/mnt/g/projects/halflife/node_modules/.pnpm/vitest@3.2.7_@types+node@22_b5ab45c71b704ef033f8ad34dd490772/node_modules:/mnt/g/projects/halflife/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/g/projects/halflife/node_modules/.pnpm/vitest@3.2.7_@types+node@22_b5ab45c71b704ef033f8ad34dd490772/node_modules/vitest/node_modules:/mnt/g/projects/halflife/node_modules/.pnpm/vitest@3.2.7_@types+node@22_b5ab45c71b704ef033f8ad34dd490772/node_modules:/mnt/g/projects/halflife/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../vitest/vitest.mjs" "$@"
else
  exec node  "$basedir/../vitest/vitest.mjs" "$@"
fi
