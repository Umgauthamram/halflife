# ==============================================================================
# Half-Life Environment Variables
# Copy this file to .env.local (for apps/web) and .env (for apps/worker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication (Auth.js v5 - Google Provider Only)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Canonical URL of the web app (e.g., http://localhost:3000 in dev)
AUTH_URL="http://localhost:3000"
# Google Cloud OAuth Web Client Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated list of admin emails (evaluated at account creation)
ADMIN_EMAILS="admin@example.com"

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection strings with least-privilege credentials
# web_app: read/write app collections, no access to wallet_keys, insert-only audit
MONGODB_URI_WEB="mongodb+srv://web_app:<password>@cluster.mongodb.net/halflife?retryWrites=true&w=majority"
# worker: access to wallet_keys, read/write ledger, atlas, jobs
MONGODB_URI_WORKER="mongodb+srv://worker:<password>@cluster.mongodb.net/halflife?retryWrites=true&w=majority"
DB_NAME="halflife"

# ------------------------------------------------------------------------------
# 3. Security & Cryptography (Worker Only)
# ------------------------------------------------------------------------------
# Master key for envelope encryption of agent wallet private keys (32 bytes base64)
# Generate with: openssl rand -base64 32
KEY_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 4. Blockchain & Network (Ethereum Sepolia Testnet - Chain ID: 11155111)
# ------------------------------------------------------------------------------
CHAIN_ID="11155111"
# Sepolia JSON-RPC endpoint (Alchemy, Infura, or public RPC)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY"

# ------------------------------------------------------------------------------
# 5. Telegraph Protocol (Ethereum Sepolia)
# ------------------------------------------------------------------------------
# Telegraph contract address on Ethereum Sepolia
TELEGRAPH_CONTRACT="0x3624EB012B5E998BB57B6bE6C9Cfc9c4bc5eb99b"
# Telegraph Node URL (IP:Port or hostname)
TELEGRAPH_NODE_URL="http://13.237.89.59:7148"
TELEGRAPH_WS_URL="wss://13.237.89.59:7148/ws"
OPERATOR_WALLET_ADDRESS="0xB980b2dBA0004e12f8efF99E5978aB1fa8179517"
# Sepolia USDC contract address expected by Telegraph
USDC_ADDRESS="0xcc194e1a843B658526D0D5C431f670028582Ae17"

# ------------------------------------------------------------------------------
# 6. Sampler & Budget Policies
# ------------------------------------------------------------------------------
# Daily spending cap for the platform Atlas sampler agent (in USDC)
SAMPLER_DAILY_CAP_USDC="10.0"

# ------------------------------------------------------------------------------
# 7. Observability & Error Tracking (Optional)
# ------------------------------------------------------------------------------
ERROR_TRACKING_DSN=""
NODE_ENV="development"

