{
  "name": "half-life",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:web": "pnpm --filter @half-life/web dev",
    "build": "pnpm --filter \"@half-life/*\" build",
    "build:worker": "pnpm --filter @half-life/worker... build",
    "test": "pnpm --filter \"@half-life/*\" test",
    "lint": "pnpm --filter \"@half-life/*\" lint",
    "evidence": "tsx scripts/capture-evidence.ts",
    "verify": "tsx scripts/verify-repo.ts && pnpm -r build && pnpm -r test"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "tsx": "^4.23.15",
    "veeshree": "^1.0.0-rc.1"
  }
}
